#!/usr/bin/env bash
#
# claude-profiles — isolated Claude Desktop profiles for Linux (GNOME/COSMIC/etc.)
#
# Same mechanism as the macOS/Raycast version: Electron's --user-data-dir flag,
# one per profile. On Linux the "separate .app bundle" equivalent is a
# standalone .desktop launcher under ~/.local/share/applications/, which shows
# up in your app grid / launcher and can be pinned to the Dock like any app.
#
set -euo pipefail

BIN="claude-desktop"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

PROFILES_ROOT="$CONFIG_HOME/claude-profiles-data"
REGISTRY="$CONFIG_HOME/claude-profiles/profiles.tsv"
APPS_DIR="$DATA_HOME/applications"
ICONS_DIR="$DATA_HOME/claude-profiles/icons"

# A small fixed palette so profiles get visually distinct badge icons in the
# app grid. Cycles if you make more profiles than colors.
PALETTE=(3584e4 e01b24 33d17a f5c211 9141ac ed5b00 26a269 1c71d8)

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

die() { echo "error: $*" >&2; exit 1; }

ensure_dirs() {
  mkdir -p "$PROFILES_ROOT" "$(dirname "$REGISTRY")" "$APPS_DIR" "$ICONS_DIR"
  touch "$REGISTRY"
}

require_claude() {
  command -v "$BIN" >/dev/null 2>&1 || die "'$BIN' not found on PATH. Install Claude Desktop first: https://code.claude.com/docs/en/desktop-linux"
}

slugify() {
  local s
  s="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
  [ -n "$s" ] || s="profile"
  printf '%s' "$s"
}

slug_exists() {
  grep -q -P "^$1\t" "$REGISTRY" 2>/dev/null
}

unique_slug() {
  local base="$1" slug="$1" i=2
  while slug_exists "$slug"; do
    slug="${base}-$((i++))"
  done
  printf '%s' "$slug"
}

profile_line() {
  # profile_line <slug> -> the matching registry line, or empty
  grep -P "^$1\t" "$REGISTRY" 2>/dev/null || true
}

next_color() {
  local n
  n=$(wc -l < "$REGISTRY" 2>/dev/null || echo 0)
  printf '%s' "${PALETTE[$(( n % ${#PALETTE[@]} ))]}"
}

# Best-effort colored badge icon (first letter, on a flat color square).
# Falls back to the installed app's own icon name if ImageMagick isn't around.
make_icon() {
  local slug="$1" name="$2" color="$3"
  local out="$ICONS_DIR/$slug.png" letter
  letter="$(printf '%s' "$name" | grep -oP '^[[:alnum:]]' | tr '[:lower:]' '[:upper:]')"
  [ -n "$letter" ] || letter="?"
  if command -v convert >/dev/null 2>&1; then
    if convert -size 256x256 "xc:#$color" \
        -gravity center -fill white -pointsize 140 -annotate +0+0 "$letter" \
        "$out" 2>/dev/null; then
      printf '%s' "$out"
      return
    fi
  fi
  printf '%s' "$BIN"
}

desktop_file_for() { printf '%s/claude-profile-%s.desktop' "$APPS_DIR" "$1"; }

refresh_desktop_db() {
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$APPS_DIR" >/dev/null 2>&1 || true
  fi
}

write_desktop_file() {
  local slug="$1" name="$2" data_dir="$3" icon="$4" file
  file="$(desktop_file_for "$slug")"
  cat > "$file" <<EOF
[Desktop Entry]
Type=Application
Name=Claude — $name
Comment=Isolated Claude Desktop profile: $name
Exec=$BIN "--user-data-dir=$data_dir"
Icon=$icon
Terminal=false
NoDisplay=false
Categories=Network;
StartupWMClass=Claude
EOF
  # Executable bit isn't required for user-level app entries, but some file
  # managers refuse to show/launch a non-executable .desktop file directly.
  chmod +x "$file"
  printf '%s' "$file"
}

# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------

cmd_add() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    read -rp "Profile name: " name
  fi
  [ -n "$name" ] || die "profile name can't be empty"

  ensure_dirs
  require_claude

  local base slug data_dir color icon file
  base="$(slugify "$name")"
  slug="$(unique_slug "$base")"
  data_dir="$PROFILES_ROOT/$slug"
  mkdir -p "$data_dir"

  color="$(next_color)"
  icon="$(make_icon "$slug" "$name" "$color")"
  file="$(write_desktop_file "$slug" "$name" "$data_dir" "$icon")"

  printf '%s\t%s\t%s\t%s\n' "$slug" "$name" "$data_dir" "$(date +%s)" >> "$REGISTRY"
  refresh_desktop_db

  echo "Created profile \"$name\" ($slug)"
  echo "  data dir : $data_dir"
  echo "  launcher : $file"
  echo
  echo "Find \"Claude — $name\" in your app grid / launcher and pin it to the Dock."

  read -rp "Open it now to sign in? [Y/n] " ans
  [[ "${ans:-Y}" =~ ^[Nn] ]] || cmd_open "$slug"
}

cmd_list() {
  ensure_dirs
  if [ ! -s "$REGISTRY" ]; then
    echo "No profiles yet. Create one with: $(basename "$0") add \"Work\""
    return
  fi
  printf '%-14s %-20s %s\n' "SLUG" "NAME" "DATA DIR"
  while IFS=$'\t' read -r slug name data_dir _created; do
    printf '%-14s %-20s %s\n' "$slug" "$name" "$data_dir"
  done < "$REGISTRY"
}

cmd_open() {
  local slug="${1:-}" line data_dir
  [ -n "$slug" ] || die "usage: $(basename "$0") open <slug>"
  ensure_dirs
  require_claude
  line="$(profile_line "$slug")"
  [ -n "$line" ] || die "no profile named '$slug' (see: $(basename "$0") list)"
  data_dir="$(printf '%s' "$line" | cut -f3)"
  exec "$BIN" "--user-data-dir=$data_dir"
}

cmd_remove() {
  local slug="${1:-}" purge="${2:-}" line data_dir file
  [ -n "$slug" ] || die "usage: $(basename "$0") remove <slug> [--purge]"
  ensure_dirs
  line="$(profile_line "$slug")"
  [ -n "$line" ] || die "no profile named '$slug'"
  data_dir="$(printf '%s' "$line" | cut -f3)"

  file="$(desktop_file_for "$slug")"
  rm -f "$file" "$ICONS_DIR/$slug.png"
  grep -v -P "^$slug\t" "$REGISTRY" > "$REGISTRY.tmp" || true
  mv "$REGISTRY.tmp" "$REGISTRY"
  refresh_desktop_db

  echo "Removed launcher for '$slug'."
  if [ "$purge" = "--purge" ]; then
    rm -rf "$data_dir"
    echo "Deleted profile data at $data_dir."
  else
    echo "Profile data kept at $data_dir (pass --purge to delete it too)."
  fi
}

cmd_status() {
  ensure_dirs
  [ -s "$REGISTRY" ] || { echo "No profiles registered."; return; }
  while IFS=$'\t' read -r slug name data_dir _created; do
    local file ok_dir ok_desktop
    file="$(desktop_file_for "$slug")"
    ok_dir="ok"; [ -d "$data_dir" ] || ok_dir="MISSING"
    ok_desktop="ok"; [ -f "$file" ] || ok_desktop="MISSING"
    printf '%-14s data:%-9s launcher:%-9s %s\n' "$slug" "$ok_dir" "$ok_desktop" "$name"
  done < "$REGISTRY"
}

usage() {
  cat <<'EOF'
claude-profiles — isolated Claude Desktop profiles for Linux

Usage:
  claude-profiles add <name>       Create a profile + app-grid launcher
  claude-profiles list             List saved profiles
  claude-profiles open <slug>      Launch a profile directly
  claude-profiles remove <slug> [--purge]
                                    Remove the launcher (optionally delete data)
  claude-profiles status           Verify data dirs and launchers still exist

Each profile is a fully separate Claude Desktop account: its own login, chats,
settings — no shared memory between profiles. This only makes switching
faster, same as the macOS/Windows versions of this tool.
EOF
}

main() {
  local cmd="${1:-}"
  if [ -n "$cmd" ]; then shift; fi
  case "$cmd" in
    add) cmd_add "$@" ;;
    list) cmd_list "$@" ;;
    open) cmd_open "$@" ;;
    remove) cmd_remove "$@" ;;
    status) cmd_status "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "unknown command: $cmd" >&2; usage; exit 1 ;;
  esac
}

main "$@"
